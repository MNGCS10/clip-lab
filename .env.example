# คัดลอกเป็น .env (หรือตั้งใน Render → Environment)
GEMINI_API_KEY=your_key_here

# ไม่บังคับ — default gemini-2.5-flash (ถูก+เร็ว)
# GEMINI_MODEL=gemini-2.5-flash

# Render ตั้ง PORT ให้เอง / local ไม่ตั้งก็ได้ (default 3000)
# PORT=3000

# ---------- แจ้งเตือน (ไม่บังคับ — ไม่ใส่ = ปิดเงียบ) ----------
# Telegram: ถอดเสร็จ ping เข้ากลุ่ม
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-1001234567890

# Notion: log ผลเข้าหน้า Master Plan อัตโนมัติ
# NOTION_TOKEN=ntn_...
# NOTION_PAGE_ID=39275f48-0e52-81f9-bf01-e1b20ce22619   # default = Master Plan อยู่แล้ว
# NOTION_VERSION=2022-06-28
